{
  "name": "@ankit6055/lex",
  "version": "0.1.0",
  "description": "A minimal, open-source, model-agnostic AI coding harness for your terminal",
  "type": "module",
  "bin": {
    "lex": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun src/cli.ts",
    "build": "bun build src/cli.ts --target=node --outfile dist/cli.js && chmod +x dist/cli.js",
    "test": "bun test",
    "typecheck": "bun check",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "keywords": [
    "ai",
    "agent",
    "harness",
    "coding-agent",
    "cli",
    "ai-sdk",
    "llm"
  ],
  "license": "MIT",
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/openai": "^4.0.122",
    "@types/bun": "latest",
    "ai": "^7.0.179",
    "picocolors": "^1.1.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "repository": "github:Ankit6055/lex",
  "publishConfig": {
    "access": "public"
  }
}
